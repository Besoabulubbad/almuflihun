{
 "$meta": {
  "name": "Quran Community design tokens",
  "version": "7.0.0",
  "rule": "Every value in the app comes from this file. No raw colours, sizes or durations in screens.",
  "units": "dp for sizes, sp for text, ms for time",
  "replaces": "v6 tokens.json and every earlier design file"
 },
 "color": {
  "light": {
   "bg": "#F5F2EC",
   "surface": "#FFFFFF",
   "surfaceSunk": "#ECE8E0",
   "mushafBg": "#FBF8F1",
   "line": "#E4DFD5",
   "lineStrong": "#D9D3C7",
   "text": "#1D1C1A",
   "textMuted": "#57534C",
   "textFaint": "#6B665D",
   "iconQuiet": "#8A857B",
   "accent": "#2F4A7A",
   "accentTint": "#E3E8F2",
   "onAccent": "#FFFFFF",
   "onAccentMuted": "#C9D4EA",
   "selection": "#F3E6BF",
   "reflectTint": "#F3E6BF",
   "onReflectTint": "#6B4E0F",
   "noteBg": "#FFF7E6",
   "noteText": "#7A5212",
   "danger": "#A3332B",
   "live": "#C2410C",
   "inverse": "#1D1C1A",
   "onInverse": "#F5F2EC",
   "onInverseMuted": "#B5B0A6",
   "inverseTrack": "#4A4740",
   "scrim": "#1D1C1A66",
   "formAlt": "#8A4B0F",
   "formAltTint": "#F6E9D8",
   "accentRing": "#4A6496",
   "accentSoft": "#9DB4DE"
  },
  "dark": {
   "bg": "#121417",
   "surface": "#1C1F24",
   "surfaceSunk": "#23272D",
   "mushafBg": "#15161A",
   "line": "#2A2E35",
   "lineStrong": "#3A3D44",
   "text": "#ECE8E0",
   "textMuted": "#A9A49A",
   "textFaint": "#959086",
   "iconQuiet": "#7F7A71",
   "accent": "#9DB4DE",
   "accentTint": "#24324A",
   "onAccent": "#121417",
   "onAccentMuted": "#24324A",
   "selection": "#4A3D1A",
   "reflectTint": "#3D3218",
   "onReflectTint": "#E8CF8F",
   "noteBg": "#2E2716",
   "noteText": "#E8CF8F",
   "danger": "#F08A80",
   "live": "#FB8A5C",
   "inverse": "#ECE8E0",
   "onInverse": "#121417",
   "onInverseMuted": "#57534C",
   "inverseTrack": "#B5B0A6",
   "scrim": "#00000099",
   "formAlt": "#E8A86B",
   "formAltTint": "#3A2A18",
   "accentRing": "#3A4D6E",
   "accentSoft": "#3A4D6E"
  },
  "moon": {
   "$note": "The Moon page always uses color.dark plus these two.",
   "lit": "#F1E9D2",
   "shadow": "#2B2A27"
  },
  "mushafLight": {
   "$note": "Reader page in light mode",
   "page": "#FBF8F1"
  }
 },
 "font": {
  "ui": {
   "family": "IBM Plex Sans Arabic",
   "weights": [
    400,
    500
   ],
   "license": "OFL, bundled"
  },
  "quranCard": {
   "family": "KFGQPC HAFS Uthmanic Script",
   "license": "KFGQPC terms, bundled",
   "use": "verses outside the Mushaf"
  },
  "quranPage": {
   "family": "QPC V2 page fonts (604)",
   "use": "Mushaf pages only, fixed layout"
  }
 },
 "type": {
  "titleL": {
   "size": 22,
   "weight": 500,
   "lineHeight": 1.4,
   "use": "onboarding titles, Moon night line"
  },
  "title": {
   "size": 18,
   "weight": 500,
   "lineHeight": 1.4,
   "use": "screen titles, sheet titles"
  },
  "subhead": {
   "size": 15,
   "weight": 500,
   "lineHeight": 1.5,
   "use": "row titles, card titles, section headers"
  },
  "body": {
   "size": 15,
   "weight": 400,
   "lineHeight": 1.6,
   "use": "post text, door summaries"
  },
  "bodyS": {
   "size": 14,
   "weight": 400,
   "lineHeight": 1.6,
   "use": "secondary paragraphs"
  },
  "label": {
   "size": 13,
   "weight": 500,
   "lineHeight": 1.4,
   "use": "buttons, chips, segmented controls"
  },
  "meta": {
   "size": 12,
   "weight": 400,
   "lineHeight": 1.5,
   "use": "refs, counts, times, row subtitles"
  },
  "caption": {
   "size": 11,
   "weight": 400,
   "lineHeight": 1.4,
   "use": "non-essential only: «بيانات مثال», timestamps on thumbnails"
  },
  "quranHero": {
   "font": "quranCard",
   "size": 20,
   "lineHeight": 2.15,
   "use": "تذكرة"
  },
  "quranCard": {
   "font": "quranCard",
   "size": 18,
   "lineHeight": 2.15,
   "use": "search results, doors, collections, stations"
  },
  "quranAttach": {
   "font": "quranCard",
   "size": 17,
   "lineHeight": 2.15,
   "use": "verses attached to posts"
  },
  "verseNumber": {
   "font": "ui",
   "size": 13,
   "weight": 400,
   "use": "﴿١٥٢﴾ markers next to text in cards"
  }
 },
 "space": {
  "0": 0,
  "2": 2,
  "4": 4,
  "8": 8,
  "12": 12,
  "16": 16,
  "20": 20,
  "24": 24,
  "32": 32,
  "40": 40
 },
 "layout": {
  "screenPadding": 16,
  "cardPadding": 12,
  "cardGap": 8,
  "sectionGap": 16,
  "rowPaddingV": 12,
  "rowPaddingH": 12,
  "sheetPadding": 16
 },
 "radius": {
  "s": 8,
  "m": 12,
  "l": 16,
  "xl": 24,
  "pill": 999
 },
 "size": {
  "touchMin": 48,
  "rowMin": 48,
  "settingsRowMin": 56,
  "topBar": 56,
  "searchField": 48,
  "button": 44,
  "chip": 32,
  "iconS": 16,
  "iconM": 20,
  "iconL": 24,
  "avatar": 32,
  "avatarL": 44,
  "thumbW": 80,
  "thumbH": 45,
  "progress": 3,
  "switchW": 44,
  "switchH": 26,
  "moonRow": 44,
  "moonHero": 132,
  "grab": 36,
  "tabBar": 64,
  "tabIndicatorW": 56,
  "tabIndicatorH": 28,
  "miniPlayer": 48,
  "miniPlayButton": 32,
  "tilawaRing": 56,
  "fab": 44,
  "artwork": 56
 },
 "border": {
  "hairline": 1,
  "focus": 2
 },
 "elevation": {
  "$note": "No shadows. Separation is by surface colour and a hairline.",
  "sheetScrim": "color.*.scrim"
 },
 "motion": {
  "fast": 120,
  "standard": 200,
  "sheet": 280,
  "emphasised": 320,
  "easing": {
   "standard": [
    0.2,
    0,
    0,
    1
   ],
   "decelerate": [
    0,
    0,
    0,
    1
   ],
   "accelerate": [
    0.3,
    0,
    1,
    1
   ]
  },
  "reducedMotion": "every movement becomes a cross-fade of motion.fast"
 },
 "icon": {
  "set": "Lucide",
  "stroke": 1.75,
  "sizes": [
   "iconS",
   "iconM",
   "iconL"
  ],
  "mirrorInRtl": [
   "back",
   "chevron",
   "list-start"
  ],
  "neverMirror": [
   "play",
   "pause",
   "skip-*",
   "repeat",
   "search",
   "volume"
  ]
 },
 "digits": {
  "system": "Arabic-Indic (٠١٢٣٤٥٦٧٨٩)",
  "listSeparator": "«،»",
  "rangeDash": "–"
 },
 "widget": {
  "radius": 24,
  "padding": 12,
  "android": {
   "quickBar": "4x1",
   "tilawa": "2x2",
   "moon": "2x2",
   "tadhkira": "4x2",
   "community": "4x2"
  },
  "ios": {
   "small": [
    "tilawa",
    "moon"
   ],
   "medium": [
    "tadhkira",
    "community"
   ],
   "lockScreen": [
    "quickSearch",
    "tilawaRing"
   ]
  },
  "rules": "Follow system theme with color.light/color.dark; the moon widget always uses color.dark. No logos. Every widget opens one deep link."
 },
 "notification": {
  "artwork": "56 dp square, mushafBg paper, surah name in quranCard font + ayah number in meta",
  "channels": [
   "tilawa_reminder",
   "live_reminder",
   "answers",
   "moderator_replies",
   "playback"
  ],
  "defaultEnabled": [
   "playback"
  ]
 },
 "spellingForms": {
  "primary": "accent (colour only)",
  "alternate": "formAlt colour + wavy underline 1 dp, offset 8 + label on formAltTint",
  "neverColourOnly": true
 }
}