-- Where the reader is (docs/specs/screens.md §4): the Mushaf and the Hizb are separate readings, each with its own
-- memory; opening one never moves the other. Positions move only when the reader reads, never on a jump, so the
-- screen can always offer «عُد إلى قراءتك». On the device only.

CREATE TABLE reading_position (
    -- "mushaf" or "hizb"
    surface TEXT NOT NULL PRIMARY KEY,
    hizb INTEGER,
    page INTEGER NOT NULL,
    surah INTEGER NOT NULL,
    ayah INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- «آخر الصفحات» (DESIGN): the last pages opened, newest first.
CREATE TABLE recent_page (
    page INTEGER NOT NULL PRIMARY KEY,
    opened_at INTEGER NOT NULL
);

position:
SELECT hizb, page, surah, ayah FROM reading_position WHERE surface = ?;

savePosition:
INSERT OR REPLACE INTO reading_position (surface, hizb, page, surah, ayah, updated_at) VALUES (?, ?, ?, ?, ?, ?);

recentPages:
SELECT page FROM recent_page ORDER BY opened_at DESC, page LIMIT ?;

openPage:
INSERT OR REPLACE INTO recent_page (page, opened_at) VALUES (?, ?);

trimRecentPages:
DELETE FROM recent_page WHERE page NOT IN (SELECT page FROM recent_page ORDER BY opened_at DESC, page LIMIT ?);
