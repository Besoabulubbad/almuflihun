-- Recent searches, shown before typing (DESIGN «Advanced search»). On the device only: search terms are never sent
-- anywhere, not even to analytics (docs/analytics/tracking-plan.md).

CREATE TABLE search_history (
    -- The whole query (terms, modes, joins, scope) as JSON; the same query twice is one row.
    query TEXT NOT NULL PRIMARY KEY,
    searched_at INTEGER NOT NULL
);

recentSearches:
SELECT query FROM search_history ORDER BY searched_at DESC LIMIT ?;

recordSearch:
INSERT OR REPLACE INTO search_history (query, searched_at) VALUES (?, ?);

trimSearches:
DELETE FROM search_history WHERE query NOT IN (SELECT query FROM search_history ORDER BY searched_at DESC LIMIT ?);

clearSearches:
DELETE FROM search_history;
