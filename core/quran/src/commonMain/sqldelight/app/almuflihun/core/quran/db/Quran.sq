-- The bundled, read-only Quran database (ADR 0015). The tables are created by QuranDatabaseBuilder in build-logic;
-- they are declared here, identically, so SQLDelight can type the queries. The app never writes to this file.

CREATE TABLE meta (key TEXT NOT NULL PRIMARY KEY, value TEXT NOT NULL) WITHOUT ROWID;

CREATE TABLE line (
    page INTEGER NOT NULL, line INTEGER NOT NULL, kind TEXT NOT NULL, centered INTEGER NOT NULL,
    first_word INTEGER, last_word INTEGER, surah INTEGER, PRIMARY KEY (page, line)
) WITHOUT ROWID;

CREATE TABLE word (
    id INTEGER NOT NULL PRIMARY KEY, surah INTEGER NOT NULL, ayah INTEGER NOT NULL,
    position INTEGER NOT NULL, page INTEGER NOT NULL, line INTEGER NOT NULL, is_end INTEGER NOT NULL,
    glyph TEXT NOT NULL, text TEXT NOT NULL, root INTEGER, lemma INTEGER, stem INTEGER
);

CREATE INDEX word_by_root ON word (root);

CREATE INDEX word_by_lemma ON word (lemma);

-- QUL's word morphology (ADR 0012): root letters without spaces; lemma and stem in the Mushaf's script.
CREATE TABLE root (id INTEGER NOT NULL PRIMARY KEY, letters TEXT NOT NULL);

CREATE TABLE lemma (id INTEGER NOT NULL PRIMARY KEY, text TEXT NOT NULL, clean TEXT NOT NULL);

CREATE TABLE stem (id INTEGER NOT NULL PRIMARY KEY, text TEXT NOT NULL, clean TEXT NOT NULL);

CREATE INDEX word_by_ayah ON word (surah, ayah, position);

CREATE TABLE ayah (
    surah INTEGER NOT NULL, ayah INTEGER NOT NULL, page INTEGER NOT NULL, simple TEXT NOT NULL,
    PRIMARY KEY (surah, ayah)
) WITHOUT ROWID;

CREATE INDEX ayah_by_page ON ayah (page);

metaValue:
SELECT value FROM meta WHERE key = ?;

pageLines:
SELECT line, kind, centered, first_word, last_word, surah FROM line WHERE page = ? ORDER BY line;

wordsBetween:
SELECT id, surah, ayah, position, line, is_end, glyph, text FROM word WHERE id BETWEEN ? AND ? ORDER BY id;

ayahWords:
SELECT id, surah, ayah, position, line, is_end, glyph, text FROM word WHERE surah = ? AND ayah = ? ORDER BY position;

ayah:
SELECT page, simple FROM ayah WHERE surah = ? AND ayah = ?;

allAyahs:
SELECT surah, ayah, simple FROM ayah ORDER BY surah, ayah;

pageGlyphs:
SELECT glyph FROM word WHERE page = ?;

CREATE TABLE surah (
    number INTEGER NOT NULL PRIMARY KEY, name TEXT NOT NULL, ayahs INTEGER NOT NULL, place TEXT NOT NULL,
    revelation_order INTEGER NOT NULL
);

CREATE TABLE quarter (number INTEGER NOT NULL PRIMARY KEY, surah INTEGER NOT NULL, ayah INTEGER NOT NULL);

CREATE TABLE sajda (surah INTEGER NOT NULL, ayah INTEGER NOT NULL, PRIMARY KEY (surah, ayah)) WITHOUT ROWID;

surahs:
SELECT s.number, s.name, s.ayahs, s.place, s.revelation_order, a.page
FROM surah s JOIN ayah a ON a.surah = s.number AND a.ayah = 1
ORDER BY s.number;

quarters:
SELECT surah, ayah FROM quarter ORDER BY number;

isSajda:
SELECT COUNT(*) FROM sajda WHERE surah = ? AND ayah = ?;

CREATE TABLE phrase_place (
    phrase INTEGER NOT NULL, surah INTEGER NOT NULL, ayah INTEGER NOT NULL,
    first_word INTEGER NOT NULL, last_word INTEGER NOT NULL
);

CREATE INDEX phrase_place_by_ayah ON phrase_place (surah, ayah);

CREATE INDEX phrase_place_by_phrase ON phrase_place (phrase);

phrasesInAyah:
SELECT phrase, first_word, last_word FROM phrase_place WHERE surah = ? AND ayah = ? ORDER BY phrase, first_word;

placesOfPhrase:
SELECT surah, ayah, first_word, last_word FROM phrase_place WHERE phrase = ? ORDER BY surah, ayah, first_word;

allPhrasePlaces:
SELECT phrase, surah, ayah, first_word, last_word FROM phrase_place ORDER BY phrase;

rootUsage:
SELECT COUNT(*) AS occurrences, COUNT(DISTINCT w.surah * 1000 + w.ayah) AS ayahs FROM word w JOIN root r ON r.id = w.root WHERE r.letters = ?;

rootLetters:
SELECT letters FROM root;

wordMorphology:
SELECT w.position, r.letters, l.text, s.text
FROM word w LEFT JOIN root r ON r.id = w.root LEFT JOIN lemma l ON l.id = w.lemma LEFT JOIN stem s ON s.id = w.stem
WHERE w.surah = ? AND w.ayah = ? AND w.is_end = 0
ORDER BY w.position;

allWordMorphology:
SELECT w.surah, w.ayah, r.letters, l.clean
FROM word w LEFT JOIN root r ON r.id = w.root LEFT JOIN lemma l ON l.id = w.lemma
WHERE w.is_end = 0
ORDER BY w.id;

wordInfo:
SELECT w.text, w.root, w.lemma, w.stem, r.letters, l.text AS lemma_text, s.text AS stem_text
FROM word w LEFT JOIN root r ON r.id = w.root LEFT JOIN lemma l ON l.id = w.lemma LEFT JOIN stem s ON s.id = w.stem
WHERE w.surah = ? AND w.ayah = ? AND w.position = ? AND w.is_end = 0;

wordsOfRoot:
SELECT w.surah, w.ayah, w.position, l.text FROM word w LEFT JOIN lemma l ON l.id = w.lemma WHERE w.root = ? ORDER BY w.id;

wordsOfLemma:
SELECT w.surah, w.ayah, w.position, l.text FROM word w LEFT JOIN lemma l ON l.id = w.lemma WHERE w.lemma = ? ORDER BY w.id;

wordsOfStem:
SELECT w.surah, w.ayah, w.position, l.text FROM word w LEFT JOIN lemma l ON l.id = w.lemma WHERE w.stem = ? ORDER BY w.id;
